{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Web via Edge",
			"request": "launch",
			"type": "msedge",
			"runtimeArgs": ["--headless", "--remote-debugging-port=9055"], // specify debug port
			"url": "http://localhost:5500/debug"
		},
		{
			"name": "DevTools Attach",
			"request": "attach",
			"type": "vscode-edge-devtools.debug",
			"port": 9055,
			"url": "http://localhost:5500/debug"
		},

		{
			"name": "JS Script",
			"request": "launch",
			"type": "node",
			"program": "${workspaceFolder}/debug/debug.js",
			"skipFiles": ["**/<node_internals>/**"]
		},
		{
			"name": "TS Script",
			"request": "launch",
			"type": "node",
			"program": "${workspaceFolder}/debug/debug.ts",
			"skipFiles": ["**/<node_internals>/**"]
		}
	],
	"compounds": [
		{
			"name": "Launch Edge & DevTools",
			"configurations": ["Web via Edge", "DevTools Attach"]
		}
	]
}
