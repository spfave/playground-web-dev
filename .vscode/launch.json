{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		// 1. Debug via F5: Run with 'F5'
		// 2. Debug via Auto Attach: Turn on setting "Auto Attach" then run in terminal

		// 3. Debug via Launch Profiles
		// DEBUG JS
		// Launch nodejs program in debug mode
		{
			"name": "Debug Node JS",
			"request": "launch",
			"type": "node",
			"program": "${workspaceFolder}/debug/debug.js",
			"skipFiles": ["**/<node_internals>/**"]
		},

		// Launch nodejs program through an npm script in debug mode
		{
			"name": "Debug Node JS via NPM",
			"request": "launch",
			"type": "node",
			"cwd": "${workspaceFolder}/debug",
			"runtimeArgs": ["run-script", "runjs"],
			"runtimeExecutable": "npm",
			"skipFiles": ["**/<node_internals>/**"]
		},

		// DEBUG TS
		// Launch nodejs program in debug mode
		{
			"name": "Debug Node TS",
			"request": "launch",
			"type": "node",
			"program": "${workspaceFolder}/debug/debug.ts",
			"skipFiles": ["**/<node_internals>/**"]
		}
	]
}
